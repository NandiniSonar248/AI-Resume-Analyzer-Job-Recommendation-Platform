# Client .dockerignore
# Prevents these files from being sent to the Docker build context.

node_modules/
npm-debug.log*
yarn-debug.log*

# Build output (rebuilt inside container)
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# Git
.git/
.gitignore

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Storybook / test artifacts
storybook-static/
coverage/
*.test.js
*.spec.js
