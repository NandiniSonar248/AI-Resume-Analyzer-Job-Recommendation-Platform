# ============================================
# AI Job Matcher - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to git!

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://127.0.0.1:27017/ats_ai_db
# Cloud: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb://127.0.0.1:27017/ats_ai_db

# JWT Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Groq AI API (FREE - Get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration (for verification & password reset)
# Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# Or use services like SendGrid, Mailgun, etc.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="JobMatch Pro <noreply@jobmatchpro.com>"

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Optional: Job Search APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
