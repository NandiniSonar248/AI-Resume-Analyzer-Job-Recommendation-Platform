# ==============================================================================
# AI Job Matcher Pro — Server Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/ats_ai_db
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/ats_ai_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ats_ai_db

# Test database (used only by integration tests)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/ats_ai_test_db

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_BEFORE_DEPLOYING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ── Groq AI API ───────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Primary model to use (must be on your plan)
# Active options: qwen/qwen3.8-27b | openai/gpt-oss-20b | openai/gpt-oss-120b
GROQ_MODEL=qwen/qwen3.8-27b

# ── Email (Nodemailer / Gmail App Password) ───────────────────────────────────
# Use a Gmail App Password, NOT your real account password.
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM="AI Job Matcher <noreply@aijobmatcher.com>"

# ── Job APIs ──────────────────────────────────────────────────────────────────
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# RapidAPI (JSearch): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# ── File Uploads ──────────────────────────────────────────────────────────────
# Max resume upload size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests per 15-minute window per IP
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=20
RATE_LIMIT_GENERAL=100

# ── Node Environment ──────────────────────────────────────────────────────────
# "development" | "production" | "test"
NODE_ENV=development

# ── Known Security Notes ──────────────────────────────────────────────────────
# Remaining npm audit items (cannot fix without breaking changes):
#   - nodemailer <=10.0.8 (high): addressparser quadratic DoS
#     Mitigation: nodemailer input is only used for internally-generated
#     verified user emails — never from untrusted external input.
#   - uuid <11.1.1 (moderate): transitive via `natural` NLP library
#   - natural 6.11.0-8.1.0 (moderate): depends on vulnerable uuid
#     Mitigation: natural is used offline for NLP scoring — no remote access.
